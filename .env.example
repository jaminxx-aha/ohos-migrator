# ohos-migrator AI client config (dotenv format).
# Copy to .env and fill in your values:  cp .env.example .env
# Load order: --env-file < <projectRoot>/.env < ./.env < ~/.env
# Existing env vars are NOT overridden by the file.
OHOS_MIGRATOR_AI_BASE_URL='https://open.bigmodel.cn/api/paas/v4'
OHOS_MIGRATOR_AI_API_KEY='YOUR_API_KEY_HERE'
OHOS_MIGRATOR_AI_MODEL='glm-4.6'
OHOS_MIGRATOR_AI_CONCURRENCY='4'
# Max idle gap (ms) between stream chunks before abort (the model stalled).
OHOS_MIGRATOR_AI_TIMEOUT_MS='120000'
# Hard total cap (ms) — backstop for a slow-but-progressing stream.
OHOS_MIGRATOR_AI_MAX_TOTAL_MS='600000'
# Where to append the AI conversation (prompt+response; API key redacted).
# Empty = default (<projectRoot>/logs/ai-conversation.log).
# off / none / nul / /dev/null = silence logging (cross-platform).
# Path MUST end in .log (rc/dotfile targets are refused — RCE guard).
OHOS_MIGRATOR_AI_LOG_FILE=
