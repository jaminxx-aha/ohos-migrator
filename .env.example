# ohos-migrator AI 模式配置示例
# 复制本文件为 .env 并填入真实值即可（放在工程根目录或当前工作目录）。
# 仅在使用 `rewrite --use-ai` 时读取；scan 与简单模式 rewrite 不需要。

# OpenAI 兼容接口的 Base URL（不带末尾斜杠）。
# 官方: https://api.openai.com/v1
# 兼容服务示例: https://your-gateway.example.com/v1
OPENAI_URL=https://api.openai.com/v1

# API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名
OPENAI_MODEL=gpt-4o

# ---- 可选别名（代码按下列优先级回退读取）----
# Base URL  : OPENAI_BASE_URL > OPENAI_URL > OPENAI_API_BASE
# API Key   : OPENAI_API_KEY > API_KEY
# Model     : OPENAI_MODEL > MODEL
